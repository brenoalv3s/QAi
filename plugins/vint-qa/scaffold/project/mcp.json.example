{
  "mcpServers": {
    "azure-devops": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@tiberriver256/mcp-server-azure-devops"],
      "env": {
        "AZURE_DEVOPS_ORG_URL": "https://dev.azure.com/SUA_ORG",
        "AZURE_DEVOPS_DEFAULT_PROJECT": "SEU_PROJETO",
        "AZURE_DEVOPS_AUTH_METHOD": "pat",
        "AZURE_DEVOPS_PAT": "SEU_PAT_AQUI"
      }
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "robotmcp": {
      "type": "stdio",
      "command": "uvx",
      "args": ["--from", "rf-mcp", "robotmcp"]
    }
  }
}
